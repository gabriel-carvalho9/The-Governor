{
    "extends":  "../../tsconfig.base.json",
    "compilerOptions":  {
                            "target":  "ES2022",
                            "module":  "CommonJS",
                            "moduleResolution":  "Node10",
                            "rootDir":  "./src",
                            "outDir":  "./dist",
                            "declaration":  true,
                            "noEmit":  false,
                            "strict":  true,
                            "skipLibCheck":  true,
                            "ignoreDeprecations":  "6.0"
                        },
    "include":  [
                    "src/**/*.ts"
                ],
    "exclude":  [
                    "dist",
                    "node_modules"
                ]
}