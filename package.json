{
    "name":  "the-governor",
    "version":  "0.1.0",
    "private":  true,
    "description":  "A systemic city and society management simulator.",
    "workspaces":  [
                       "apps/*",
                       "packages/*"
                   ],
    "engines":  {
                    "node":  "\u003e=22"
                },
    "scripts":  {
                    "dev:frontend":  "npm run dev --workspace=@the-governor/frontend",
                    "dev:backend":  "npm run start:dev --workspace=@the-governor/backend",
                    "build":  "npm run build --workspace=@the-governor/shared \u0026\u0026 npm run build --workspace=@the-governor/backend \u0026\u0026 npm run build --workspace=@the-governor/frontend",
                    "test":  "npm run test --workspaces --if-present"
                },
    "devDependencies":  {
                            "typescript":  "^6.0.3"
                        }
}